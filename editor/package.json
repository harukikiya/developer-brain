{
  "name": "developer-brain",
  "displayName": "Developer Brain",
  "description": "Code-aware knowledge graph for VS Code (Rust core).",
  "version": "0.0.1",
  "publisher": "developer-brain",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "developerBrain.showGraph",
        "title": "Developer Brain: Show Graph"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "build": "npm run typecheck && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
